<Window x:Class="RecursiveMediaPlayer.ConfigWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="递归媒体播放器" Width="620" Height="734" MinWidth="540" MinHeight="580" WindowStartupLocation="CenterScreen" Background="#F4F6FA" FontFamily="Microsoft YaHei UI" FontSize="14">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="32,24">
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="i" Width="32" Height="32" Padding="0" Margin="12,0,0,0" FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold" ToolTip="查看使用教程" AutomationProperties.Name="使用教程" Click="ShowHelp" VerticalAlignment="Center">
        <Button.Template><ControlTemplate TargetType="Button">
          <Border x:Name="InfoBorder" CornerRadius="16" Background="White" BorderBrush="#94A3B8" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InfoBorder" Property="Background" Value="#DBEAFE"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InfoBorder" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="InfoBorder" Property="BorderThickness" Value="2"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Button.Template>
      </Button>
      <TextBlock Text="递归媒体播放器" FontSize="26" FontWeight="SemiBold"/>
    </DockPanel>
    <TextBlock Text="RECURSIVE MEDIA PLAYER" Foreground="#64748B" FontSize="11" Margin="0,4,0,24"/>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="文件夹" VerticalAlignment="Center"/><TextBox x:Name="Folder" Grid.Column="1" Padding="8" VerticalContentAlignment="Center"/><Button Grid.Column="2" Content="浏览" Click="Browse"/>
    </Grid>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><TextBlock Text="图片时长" Width="88" VerticalAlignment="Center"/><TextBox x:Name="Duration" Width="130" Padding="8"/><TextBlock Text="ms" Margin="10,0" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="图片筛选" Width="88" VerticalAlignment="Center"/><RadioButton x:Name="ImageLandscape" GroupName="image" Content="横屏"/><RadioButton x:Name="ImagePortrait" GroupName="image" Content="竖屏"/><RadioButton x:Name="ImageAll" GroupName="image" Content="所有"/><RadioButton x:Name="ImageDisabled" GroupName="image" Content="禁用"/></StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="视频筛选" Width="88" VerticalAlignment="Center"/><RadioButton x:Name="VideoLandscape" GroupName="video" Content="横屏"/><RadioButton x:Name="VideoPortrait" GroupName="video" Content="竖屏"/><RadioButton x:Name="VideoAll" GroupName="video" Content="所有"/><RadioButton x:Name="VideoDisabled" GroupName="video" Content="禁用"/></StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="播放顺序" Width="88" VerticalAlignment="Center"/><RadioButton x:Name="Sequential" GroupName="order" Content="顺序"/><RadioButton x:Name="RandomOrder" GroupName="order" Content="随机"/></StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="显示模式" Width="88" VerticalAlignment="Center"/><RadioButton x:Name="Fullscreen" GroupName="display" Content="全屏"/><RadioButton x:Name="Windowed" GroupName="display" Content="窗口化"/></StackPanel>
    <StackPanel Orientation="Horizontal"><CheckBox x:Name="Loop" Content="循环播放"/><CheckBox x:Name="Muted" Content="静音"/><CheckBox x:Name="Recursive" Content="包含子文件夹"/></StackPanel>
    <TextBlock x:Name="Error" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,6"/>
    <Button Content="开始播放" Click="Start" Height="186" Background="#2563EB" Foreground="White" BorderThickness="0" FontSize="20" FontWeight="SemiBold" Margin="24,8"/>
    <Button x:Name="ClearDataButton" Content="清空配置和缓存" Click="ClearData" HorizontalAlignment="Center" Margin="0,4,0,8" ToolTip="清除保存的选项和扫描缓存；不会删除图片或视频文件"/>
    <Button Content="退出" Click="Exit" HorizontalAlignment="Center" Margin="0,10"/>
  </StackPanel></ScrollViewer>
</Window>
